# ==========================================
# TicketPass Backend Environment Variables
# ==========================================

# Port (Cloud providers like Render/Railway automatically assign PORT)
PORT=9090

# Node Environment ('production' enables secure cookies, trust proxy, and vercel origin allowance)
NODE_ENV=production

# Database Connection String (PostgreSQL / Neon Serverless)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@your-host.neon.tech/neondb?sslmode=require"

# JWT Secret Key for token signing (Must be a long, random secure string)
KEY="your_super_secret_jwt_key_at_least_32_characters_long"

# Allowed Frontend Origins (Comma-separated URLs)
# Include your production frontend domain (e.g., Vercel, Netlify, Custom Domain)
CLIENT_URL="https://your-ticketpass-frontend.vercel.app"
ALLOWED_ORIGINS="https://your-ticketpass-frontend.vercel.app,http://localhost:3000"

# (Optional) TMDB API Key for live Now-Playing movie synchronization
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
